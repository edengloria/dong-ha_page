{
  "name": "dong-ha-page",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "studio",
    "publishing"
  ],
  "scripts": {
    "dev": "astro dev",
    "dev:studio": "npm run dev --workspace studio",
    "dev:preview": "npm run dev --workspace publishing",
    "build:studio": "npm run build --workspace studio",
    "build:preview": "npm run build --workspace publishing",
    "test:publishing": "tsx --test scripts/tests/publishing.test.ts scripts/tests/comments.test.ts",
    "build": "astro build",
    "start": "astro preview",
    "lint": "astro check && eslint . --max-warnings=0",
    "fetch-discogs": "tsx scripts/fetch-discogs.ts",
    "optimize-images": "tsx scripts/optimize-images.ts",
    "sort-by-color": "tsx scripts/sort-by-color.ts",
    "profile:build": "npm run build",
    "profile:serve": "npm exec --yes --package serve -- serve out -l 3001",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:zoom": "node scripts/check-scene-zoom.mjs",
    "predev": "node scripts/prepare-thorvg.mjs",
    "prebuild": "node scripts/prepare-thorvg.mjs",
    "test:server": "node --test scripts/tests/preferences.test.mjs"
  },
  "dependencies": {
