---
import TaxonomyPage from '../../../components/blog/TaxonomyPage.astro'
import { getPublishingData } from '../../../../lib/publishing/query'
export async function getStaticPaths() {
  const { posts, tags } = await getPublishingData()
  return tags.map(item => ({ params: { slug: item.slug.current }, props: { item, posts: posts.filter(post => post.tags?.some(value => value._id === item._id)) } }))
}
const { item, posts } = Astro.props
---
<TaxonomyPage kind="tags" title={item.title} description={item.description} path={`/blog/tags/${item.slug.current}/`} posts={posts} />

