---
import TaxonomyPage from '../../../components/blog/TaxonomyPage.astro'
import { getPublishingData } from '../../../../lib/publishing/query'
export async function getStaticPaths() {
  const { posts, series } = await getPublishingData()
  return series.map(item => ({ params: { slug: item.slug.current }, props: { item, posts: posts.filter(post => post.series?._id === item._id).sort((a, b) => a.language.localeCompare(b.language) || (a.seriesOrder ?? 9999) - (b.seriesOrder ?? 9999)) } }))
}
const { item, posts } = Astro.props
---
<TaxonomyPage kind="series" title={item.title} description={item.description} path={`/blog/series/${item.slug.current}/`} posts={posts} />

