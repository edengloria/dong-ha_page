---
import TaxonomyPage from '../../../components/blog/TaxonomyPage.astro'
import { getPublishingData } from '../../../../lib/publishing/query'
import { articleTypes } from '../../../../lib/publishing/types'
export async function getStaticPaths() {
  const { posts } = await getPublishingData()
  return articleTypes.map(type => ({ params: { slug: type.value }, props: { type, posts: posts.filter(post => post.articleType === type.value) } }))
}
const { type, posts } = Astro.props
---
<TaxonomyPage kind="types" title={type.title} path={`/blog/types/${type.value}/`} posts={posts} />
