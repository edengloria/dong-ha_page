---
import { postPath, type Post } from '../../../lib/publishing/types'
import { withBasePath } from '../../../lib/paths'
interface Props { posts: Post[]; empty?: string }
const { posts, empty = '아직 발행된 글이 없습니다.' } = Astro.props
---
{posts.length ? <ol class="post-list">{posts.map(post => <li>
  <time datetime={post.publishedAt}>{post.publishedAt?.slice(0, 10)}</time>
  <a href={withBasePath(postPath(post))} lang={post.language}>{post.title}</a>
</li>)}</ol> : <p class="blog-empty">{empty}</p>}
