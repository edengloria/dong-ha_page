---
import { messages, type Language } from '../../../lib/publishing/language'
interface Props { thread: string; endpoint: string; preview?: boolean; language?: Language }
const { thread, endpoint, preview = false, language = 'en' } = Astro.props
const t = messages[language]
---
{!preview && <section id="comments" class="comments" data-comments data-thread={thread} data-endpoint={endpoint} data-language={language} data-pagefind-ignore aria-labelledby="comments-title">
  <h2 id="comments-title">{thread === 'guestbook' ? t.guestbook : t.comments}</h2>
  <p data-comment-list-status role="status" aria-live="polite"></p>
  <ol class="comment-list" data-comment-list></ol>
  <button type="button" data-comment-more hidden>{t.more}</button>
  <noscript><a href={`${endpoint.replace('/api/comments/', '/comments/')}?thread=${encodeURIComponent(thread)}&language=${language}`}>{t.readComments}</a></noscript>
</section>}
<script src="../../../lib/publishing/comments-client.ts"></script>
