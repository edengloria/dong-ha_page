---
import { messages, type Language } from '../../../lib/publishing/language'
interface Props { thread: string; endpoint: string; disabled?: boolean; language?: Language }
const { thread, endpoint, disabled = false, language = 'en' } = Astro.props
const t = messages[language]
---
<form action={endpoint} method="post" class="comment-form" data-comment-form>
  <input type="hidden" name="thread" value={thread} />
  <input type="hidden" name="action" value="create" />
  <input type="hidden" name="language" value={language} />
  <fieldset disabled={disabled}>
    <label for="comment-name">{t.name}</label>
    <input id="comment-name" name="name" type="text" required maxlength="60" autocomplete="nickname" />
    <label for="comment-password">{t.password} <small>{t.passwordHint}</small></label>
    <input id="comment-password" name="password" type="password" required minlength="4" maxlength="128" autocomplete="new-password" />
    <label for="comment-message" class="sr-only">{thread === 'guestbook' ? t.guestbookMessage : t.commentMessage}</label>
    <textarea id="comment-message" name="message" rows="10" required maxlength="4000"></textarea>
    <label class="comment-trap" aria-hidden="true">Website<input name="website" type="text" tabindex="-1" autocomplete="off" /></label>
    <button type="submit">{t.write}</button>
  </fieldset>
  <p class="comment-status" role="status" aria-live="polite">{disabled ? t.previewDisabled : ''}</p>
</form>
