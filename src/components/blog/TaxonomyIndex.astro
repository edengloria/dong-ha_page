---
import BlogDocument from '../../layouts/BlogDocument.astro'
import BlogShell from './BlogShell.astro'
import BlogNavigation from './BlogNavigation.astro'
import { withBasePath } from '../../../lib/paths'
interface Props { kind: string; title: string; items: { title: string; slug: string; count: number; description?: string }[] }
const { kind, title, items } = Astro.props
---
<BlogDocument title={title} description={`${title} — Research & engineering notes by Dong-Ha Shin.`} path={`/blog/${kind}/`}>
  <BlogShell><main id="main-content" class="blog-index"><BlogNavigation active={kind} /><h1>{title}</h1>
    {items.length ? <ul class="taxonomy-list">{items.map(item => <li><h2><a href={withBasePath(`/blog/${kind}/${item.slug}/`)}>{item.title}</a> <span class="taxonomy-count">{item.count}</span></h2>{item.description && <p>{item.description}</p>}</li>)}</ul> : <p class="blog-empty">아직 등록된 항목이 없습니다.</p>}
  </main></BlogShell>
</BlogDocument>
